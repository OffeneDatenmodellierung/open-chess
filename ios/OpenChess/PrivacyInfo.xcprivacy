<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the app collects and why (docs/privacy.md), and the reasons it
     uses APIs Apple asks about. Nothing tracks; nothing is for advertising. -->
